<%
  fq = CONTENT['faq']
  sections = fq['sections'].each_with_index.map { |s, i| s.merge('id' => slugify(s['title']).then { |x| x.empty? ? "rubrique-#{i + 1}" : x }) }
  faq_schema = { '@context' => 'https://schema.org', '@type' => 'FAQPage',
                 'mainEntity' => sections.flat_map { |s| s['questions'].map { |qa| { '@type' => 'Question', 'name' => tokens(qa['q']), 'acceptedAnswer' => { '@type' => 'Answer', 'text' => tokens(qa['a']) } } } } }
-%>
<%= json_ld(faq_schema) %>
<header class="page-head page-head--sand">
  <div class="wrap">
    <p class="eyebrow">Aide</p>
    <h1><%= h(fq['title']) %></h1>
    <p class="lead"><%= h(tokens(fq['lead'])) %> Vous ne trouvez pas ? <a href="/contact/">Écrivez-nous</a>.</p>
  </div>
</header>

<section class="section" style="padding-top:40px">
  <div class="wrap wrap--narrow">
    <nav class="faq-nav" aria-label="Rubriques de la FAQ">
<% sections.each do |s| -%>
      <a href="#<%= s['id'] %>"><%= h(s['title']) %></a>
<% end -%>
      <a href="#guide-des-tailles">Guide des tailles</a>
    </nav>

<% sections.each do |s| -%>
    <h2 id="<%= s['id'] %>" style="margin-top:44px;font-size:1.5rem"><%= h(s['title']) %></h2>
<% s['questions'].each do |qa| -%>
    <details class="acc">
      <summary style="text-transform:none;letter-spacing:0;font-size:1rem"><%= h(tokens(qa['q'])) %></summary>
      <div class="acc__body"><%= paragraphs(tokens(qa['a'])) %></div>
    </details>
<% end -%>
<% end -%>

    <h2 id="guide-des-tailles" style="margin-top:60px;font-size:1.5rem">Guide des tailles</h2>
    <%= paragraphs(tokens(fq['size_intro'])) %>
    <%= size_table %>
    <%= paragraphs(tokens(fq['size_note'])) %>
    <div class="notice">Entre deux tailles ? Choisissez la plus grande pour une coupe plus décontractée. Pour un conseil personnalisé, appelez-nous au <a href="tel:<%= SITE['phone_intl'] %>"><%= h(SITE['phone']) %></a>.</div>
  </div>
</section>
